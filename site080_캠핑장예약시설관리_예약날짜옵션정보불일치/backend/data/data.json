  "reviews": [
    { "id": "REV-001", "campsiteId": "CAMP-01", "author": "김철수", "rating": 5, "content": "설악산 공기가 맑고 오토캠핑 사이트 시설이 매우 깨끗합니다!", "createdAt": "2026-07-28" },
    { "id": "REV-002", "campsiteId": "CAMP-02", "author": "이영희", "content": "자라섬 글램핑 침구가 따뜻하고 야경이 환상적이었어요.", "rating": 5, "createdAt": "2026-07-29" },
    { "id": "REV-003", "campsiteId": "CAMP-03", "author": "박민수", "content": "산정호수 둘레길 접근성이 무척 뛰어납니다.", "rating": 4, "createdAt": "2026-07-30" },
    { "id": "REV-004", "campsiteId": "CAMP-04", "author": "정수진", "content": "안면도 석양이 카라반 전면 창문에서 바로 보여 인상적이었습니다.", "rating": 5, "createdAt": "2026-07-31" },
    { "id": "REV-005", "campsiteId": "CAMP-05", "author": "최동현", "content": "오대산 솔숲 백패킹 존 계곡 소리가 힐링 그 자체예요.", "rating": 5, "createdAt": "2026-08-01" },
    { "id": "REV-006", "campsiteId": "CAMP-06", "author": "강서연", "content": "애월 바다 오션뷰 글램핑시설 최고였습니다.", "rating": 5, "createdAt": "2026-08-02" },
    { "id": "REV-007", "campsiteId": "CAMP-07", "author": "윤재호", "content": "남한강 차박 오토캠핑 사이트 수전 시설이 편리합니다.", "rating": 4, "createdAt": "2026-08-02" },
    { "id": "REV-008", "campsiteId": "CAMP-08", "author": "한지민", "content": "소백산 데크 사이즈가 커서 대형 텐트 치기 좋았습니다.", "rating": 5, "createdAt": "2026-08-01" },
    { "id": "REV-009", "campsiteId": "CAMP-09", "author": "임건우", "content": "경주 감성 글램핑 불멍 옵션 장작 품질이 무척 만족스럽네요.", "rating": 5, "createdAt": "2026-07-30" },
    { "id": "REV-010", "campsiteId": "CAMP-10", "author": "송예은", "content": "남해 해변 사이트는 밤바다 소리가 일품입니다.", "rating": 4, "createdAt": "2026-07-29" },
    { "id": "REV-011", "campsiteId": "CAMP-11", "author": "오현우", "content": "경포대 해변 차박존 샤워실 이용 가능해서 쾌적해요.", "rating": 4, "createdAt": "2026-07-28" },
    { "id": "REV-012", "campsiteId": "CAMP-12", "author": "신나영", "content": "한라산 프리미엄 글램핑 돔 온도 조절 시설이 훌륭합니다.", "rating": 5, "createdAt": "2026-07-27" },
