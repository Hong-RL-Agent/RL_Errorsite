  "questions": [
    { "id": "QST-01", "category": "기본 증상", "questionText": "현재 가장 불편하신 주요 통증 또는 증상은 무엇인가요?" },
    { "id": "QST-02", "category": "발병 시기", "questionText": "해당 증상이 시작된 지 얼마나 지나셨나요?" },
    { "id": "QST-03", "category": "통증 강도", "questionText": "통증 강도를 1부터 10까지 점수로 평가해주세요." },
    { "id": "QST-04", "category": "기저 질환", "questionText": "고혈압, 당뇨, 고지혈증 등 기저질환이 있으신가요?" },
    { "id": "QST-05", "category": "복용 약물", "questionText": "현재 정기적으로 복용 중인 처방약이나 영양제가 있나요?" },
    { "id": "QST-06", "category": "알레르기", "questionText": "특정 약물, 음식, 주사제에 대한 알레르기 반응이 있으신가요?" },
    { "id": "QST-07", "category": "수술 이력", "questionText": "과거 입원 치료나 수술을 받으신 적이 있나요?" },
    { "id": "QST-08", "category": "음주 여부", "questionText": "주당 음주 횟수 및 1회 평균 음주량은 어떻게 되시나요?" },
    { "id": "QST-09", "category": "흡연 여부", "questionText": "현재 흡연 여부 및 1일 평균 흡연량은 어떻게 되시나요?" },
    { "id": "QST-10", "category": "가족력", "questionText": "직계 가족 중 암, 심장질환, 뇌졸중 내력이 있으신가요?" },
    { "id": "QST-11", "category": "체중 변화", "questionText": "최근 6개월 내 원인 불명의 체중 감소가 있으셨나요?" },
    { "id": "QST-12", "category": "발열 여부", "questionText": "최근 3일 내 37.5도 이상의 고열이나 오한이 있었나요?" },
    { "id": "QST-13", "category": "호흡 상태", "questionText": "평지 걸을 때 숨이 차거나 호흡 곤란 증상이 있나요?" },
    { "id": "QST-14", "category": "수면 상태", "questionText": "수면 장애나 불면증, 수면 무호흡증이 있으신가요?" },
    { "id": "QST-15", "category": "소화 상태", "questionText": "속쓰림, 헛구역질, 소화불량 또는 복통이 자주 발생하나요?" },
    { "id": "QST-16", "category": "배변 이상", "questionText": "최근 혈변, 흑색변, 만성 설사 또는 변비가 있으신가요?" },
    { "id": "QST-17", "category": "두통/어지럼증", "questionText": "갑작스러운 심한 두통이나 시야 장애, 어지럼증이 있나요?" },
    { "id": "QST-18", "category": "관절 부종", "questionText": "관절이 열감이 있거나 붓고 통증이 동반되나요?" },
    { "id": "QST-19", "category": "피부 증상", "questionText": "피부 두드러기, 가려움증, 진물 또는 발진이 있나요?" },
    { "id": "QST-20", "category": "시력 이상", "questionText": "갑작스러운 안구 통증, 충혈 또는 눈부심 증상이 있나요?" },
    { "id": "QST-21", "category": "임신/수유", "questionText": "현재 임신 가능성이나 임신 중, 수유 중이신가요?" },
    { "id": "QST-22", "category": "최근 종합검진", "questionText": "최근 1년 이내 위/대장 내시경 검사를 받으셨나요?" },
    { "id": "QST-23", "category": "운동량", "questionText": "일주일에 30분 이상 땀이 나는 운동을 몇 회 하시나요?" },
    { "id": "QST-24", "category": "스트레스 지수", "questionText": "일상생활에서의 정신적 스트레스 수준은 어느 정도인가요?" },
    { "id": "QST-25", "category": "방문 목적", "questionText": "이번 진료 방문 시 원하시는 핵심 상담/치료 내용은 무엇인가요?" }
